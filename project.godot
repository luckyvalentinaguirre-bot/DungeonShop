; Engine configuration file.
; Dungeon Shop — Godot 4.x project
;
; This file defines project-wide settings, autoloads (singletons/managers),
; input map and rendering configuration. Autoloads are intentionally the ONLY
; global state in the project; every other system is composed from nodes and
; Resources (see docs/systems/00_Architecture.md).

config_version=5

[application]

config/name="Dungeon Shop"
config/description="A cozy medieval shop-keeping game. You are not the hero — you run the store."
run/main_scene="res://game/scenes/Menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icons/icon.svg"

[autoload]

; Reinicio desde cero (Etapa 1-2). Solo el sistema de carga de assets por ahora;
; el resto de sistemas se agregaran por etapas. El codigo antiguo esta aislado con
; .gdignore (carpetas scripts/ scenes/ tests/ resources/), Godot no lo compila.
AssetLibrary="*res://game/scripts/AssetLibrary.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="forward_plus"

[input]

; Input actions are documented in docs/systems/13_Controls.md.
; Declared here so scripts can reference them before UI exists.
ui_interact={
"deadzone": 0.5,
"events": []
}
pause_game={
"deadzone": 0.5,
"events": []
}
quick_save={
"deadzone": 0.5,
"events": []
}

[localization]

; See localization/ — CSV-based translations loaded at boot.
locale/fallback="en"
